{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReMa",
  "version": "0.1.0",
  "identifier": "cloud.datasound.rema",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReMa",
        "width": 1200,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#F8F7F4",
      "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 20 }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost rema-doc: http://rema-doc.localhost; img-src 'self' data: blob: rema-doc: http://rema-doc.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Career UI Harness",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
